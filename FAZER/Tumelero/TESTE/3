alvar o arquivo CSV no Google Drive\n","output_dir = '/content/drive/MyDrive/scraping_outputs'\n","if not os.path.exists(output_dir):\n","    os.makedirs(output_dir)\n","output_path = os.path.join(output_dir, 'tumelero_produtos.csv')\n","\n","# Configuração do WebDriver para uso no Colab\n","chrome_options = webdriver.ChromeOptions()\n","chrome_options.add_argument('--headless')\n","chrome_options.add_argument('--no-sandbox')\n","chrome_options.add_argument('--disable-dev-shm-usage')\n","\n","# Inicializa o WebDriver\n","driver = webdriver.Chrome(options=chrome_options)\n","\n","# Abre a página do Tumelero\n","driver.get('https://www.tumelero.com.br/pisos-e-revestimentos/pisos/pisos-ceramicos')\n","\n","# Espera até que os elementos de produtos estejam visíveis\n","try:\n","    WebDriverWait(driver, 10).until(\n","        EC.presence_of_element_located((By.CSS_SELECTOR, 'li[data-smarthintfeature=\"search\"]'))\n","    )\n","except TimeoutException:\n","    print(\"Tempo de espera expirou. Não foi possível encontrar os produtos.\")\n","    driver.quit()\n","    exit()\n","\n","# Função para fechar possíveis overlays\n","def fechar_overlay():\n","    try:\n","        overlays = driver.find_elements(By.CSS_SELECTOR, 'div.onetrust-pc-dark-filter')\n","        for overlay in overlays:\n","            driver.execute_script(\"arguments[0].click();\", overlay)\n","            time.sleep(1)  # Aguarda a remoção do overlay\n","    except NoSuchElementException:\n","        print(\"Nenhum overlay encontrado.\")\n","\n","# Função para extrair dados da página\n","def extrair_dados():\n","    dados = []\n","    pagina_atual = 1\n","\n","    while True:\n","        try:\n","            produtos = driver.find_elements(By.CSS_SELECTOR, 'li[data-smarthintfeature=\"search\"]')\n","            print(f\"Total de produtos encontrados nesta página: {len(produtos)}\")\n","\n","            for produto in produtos:\n","                try:\n","                    nome = produto.find_element(By.CSS_SELECTOR, 'h2.x-shelf__title').text\n","                    # Atualize o seletor conforme necessário\n","                    try:\n","                        preco = produto.find_element(By.CSS_SELECTOR, 'span.x-shelf__best-price strong').text\n","                    except NoSuchElementException:\n","                        preco = 'Preço não disponível'\n","                    imagem = produto.find_element(By.CSS_SELECTOR, 'div.x-shelf__img-container img').get_attribute('src')\n","                    link = produto.find_element(By.CSS_SELECTOR, 'div.x-shelf__img-container a').get_attribute('href')\n","\n","                    dados.append({\n","                        'nome': nome,\n","                        'preco': preco,\n","                        'imagem': imagem,\n","                        'link': link\n","                    })\n","                except NoSuchElementException as e:\n","                    print(f\"Elemento não encontrado dentro do produto: {e}\")\n","                    continue\n","\n","            try:\n","                # Tenta encontrar e fechar possíveis overlays\n","                fechar_overlay()\n","\n","                # Tenta encontrar o botão \"Mais produtos\"\n","                botao_mais = WebDriverWait(driver, 20).until(\n","                    EC.presence_of_element_located((By.CSS_SELECTOR, 'div.father-loadmore-smarthint button.cf-load-more'))\n","                )\n","                driver.execute_script(\"arguments[0].scrollIntoView(true);\", botao_mais)  # Scroll para o botão\n","\n","                # Tenta clicar no botão e lida com overlays\n","                try:\n","                    WebDriverWait(driver, 20).until(\n","                        EC.element_to_be_clickable((By.CSS_SELECTOR, 'div.father-loadmore-smarthint button.cf-load-more'))\n","                    ).click()\n","                    time.sleep(2)  # Espera o carregamento dos produtos\n","                except ElementClickInterceptedException:\n","                    print(\"Overlay ou outro elemento interceptou o clique. Tentando novamente...\")\n","                    driver.execute_script(\"arguments[0].click();\", botao_mais)\n","                    time.sleep(2)\n","\n","                pagina_atual += 1\n","                print(f\"Next page: {pagina_atual}\")\n","\n","            except NoSuchElementException:\n","                print(\"Não foi possível encontrar o botão 'Mais produtos'.\")\n","                break\n","            except StaleElementReferenceException:\n","                print(\"O botão 'Mais produtos' não está mais disponível. Encerrando coleta.\")\n","                break\n","\n","        except NoSuchElementException as e:\n","            print(f\"Erro ao encontrar produtos: {e}\")\n","            break\n","\n","    return dados\n","\n","# Execução principal\n","dados = extrair_dados()\n","\n","# Verifica se dados foram coletados\n","if not dados:\n","    print(\"Nenhum dado coletado.\")\n","else:\n","    # Exibe os dados coletados no console\n","    for dado in dados:\n","        print(f\"Nome: {dado['nome']}, Preço: {dado['preco']}, Imagem: {dado['imagem']}, Link: {dado['link']}\")\n","\n","# Salva os dados no arquivo CSV\n","if dados:\n","    with open(output_path, 'w', newline='', encoding='utf-8') as file:\n","        writer = csv.DictWriter(file, fieldnames=['nome', 'preco', 'imagem', 'link'])\n","        writer.writeheader()\n","        writer.writerows(dados)\n","    print(f\"Dados salvos em {output_path}\")\n","\n","# Fechando o navegador\n","driver.quit()\n"]}]}