o até 1 produto para: pisos intertravado\n","⚠️ Limite de 1 atingido para a categoria 'pisos intertravado'.\n","🔍 Buscando até 1 produto para: carpetes\n","⚠️ Limite de 1 atingido para a categoria 'carpetes'.\n","🔍 Buscando até 1 produto para: pedras para piso\n","⚠️ Limite de 1 atingido para a categoria 'pedras para piso'.\n","✅ Total de links coletados: 11\n","\n","🔍 1/11 -> https://www.leroymerlin.com.br/carpete-grafite-para-eventos-feiras-shows-casamentos-formaturas-festivais--por-metro-quadrado-_1571812782\n","🔍 2/11 -> https://www.leroymerlin.com.br/ladrilho-hidraulico-quadrado-amaralis-azul-e-branco-20x20cm-oficina-yby_91879116\n","🔍 3/11 -> https://www.leroymerlin.com.br/ladrilho-para-calcada-25-quadros-branco-20x20cm-cimartex_89069526\n","🔍 4/11 -> https://www.leroymerlin.com.br/piso-ceramico-marmorizado-brilhante-borda-arredondada-interno-61,5x61,5cm-brisa-rosagres_91700182\n","🔍 5/11 -> https://www.leroymerlin.com.br/piso-ceramico-pedra-acetinado-borda-arredondada-externo-57x57cm-mineral-lef_91723660\n","🔍 6/11 -> https://www.leroymerlin.com.br/piso-concregrama-29x43cm-natural-oterprem_92055761\n","🔍 7/11 -> https://www.leroymerlin.com.br/piso-de-borracha-ultra-impact-16mm-placa-0,50-x-0,50m-preto-decortech_1566981062\n","🔍 8/11 -> https://www.leroymerlin.com.br/piso-intertravado-retangular-10x20x6cm-natural-oterprem_92055684\n","🔍 9/11 -> https://www.leroymerlin.com.br/piso-laminado-prime-cappuccino-136x19,7cm-m2-eucafloor_87744965\n","🔍 10/11 -> https://www.leroymerlin.com.br/piso-vinilico-autocolante-amadeirado-regua-m2-angelim-tubrax_1570771313\n","🔍 11/11 -> https://www.leroymerlin.com.br/porcelanato-cimenticio-acetinado-borda-reta-interno-71x71cm-max-loft-off-white-71222-embramaco_92303141\n","📄 Excel salvo em: leroymerelin_coleta/leroymerelin_2025-07-07.xlsx\n","📄 CSV salvo em: leroymerelin_coleta/leroymerelin_2025-07-07.csv\n","📦 Imagens zipadas em: leroymerelin_coleta/imagens_leroymerelin_2025-07-07.zip\n"]}],"source":["# ========================\n","# PARTE 0: INSTALAÇÕES (Google Colab)\n","# ========================\n","!apt-get update > /dev/null\n","!apt install chromium-chromedriver -y > /dev/null || true\n","!cp /usr/lib/chromium-browser/chromedriver /usr/bin || true\n","!pip install selenium > /dev/null\n","!pip install pandas openpyxl requests > /dev/null\n","\n","# ========================\n","# PARTE 1: IMPORTS E CONFIGURAÇÕES\n","# ========================\n","from selenium import webdriver\n","from selenium.webdriver.chrome.options import Options\n","from selenium.webdriver.common.by import By\n","from selenium.webdriver.support.ui import WebDriverWait\n","from selenium.webdriver.support import expected_conditions as EC\n","from selenium.common.exceptions import TimeoutException\n","import pandas as pd\n","import os, time, requests, zipfile\n","from datetime import datetime\n","\n","options = Options()\n","options.binary_location = \"/usr/bin/chromium-browser\"\n","options.add_argument(\"--headless\")\n","options.add_argument(\"--no-sandbox\")\n","options.add_argument(\"--disable-dev-shm-usage\")\n","driver = webdriver.Chrome(options=options)\n","wait = WebDriverWait(driver, 15)\n","\n","# ========================\n","# PARTE 2: CONFIGURAÇÃO ALGOLIA\n","# ========================\n","ALGOLIA_APP_ID = \"1CF3ZT43ZU\"\n","ALGOLIA_API_KEY = \"150c68d1c61fc1835826a57a203dab72\"\n","ALGOLIA_INDEX = \"production_products\"\n","\n","headers_algolia = {\n","    \"Content-Type\": \"application/json\",\n","    \"X-Algolia-Application-Id\": ALGOLIA_APP_ID,\n","    \"X-Algolia-API-Key\": ALGOLIA_API_KEY,\n","}\n","\n","termos_busca = [\n","    \"porcelanato\",\n","    \"pisos ceramicos\",\n","    \"pisos vinilicos\",\n","    \"pisos laminados\",\n","    \"piso emborrachado\",\n","    \"ladrilho hidraulico\",\n","    \"ladrilhos para calçada\",\n","    \"pisogramas\",\n","    \"pisos intertravado\",\n","    \"carpetes\",\n","    \"pedras para piso\"\n","]\n","\n","def buscar_links_por_categoria(termos, max_paginas=50, limite_por_categoria=1):\n","    links = set()\n","    for termo in termos:\n","        print(f\"🔍 Buscando até {limite_por_categoria} produto para: {termo}\")\n","        contador_cat = 0\n","        for pagina in range(max_paginas):\n","            url = f\"https://{ALGOLIA_APP_ID}-dsn.algolia.net/1/indexes/{ALGOLIA_INDEX}/query\"\n","            payload = {\n","                \"params\": f\"query={termo}&page={pagina}&hitsPerPage=100\"\n","            }\n","            res = requests.post(url, headers=headers_algolia, json=payload)\n","            if res.status_code != 200:\n","                print(f\"⚠️ Erro na requisição para '{termo}' página {pagina}\")\n","                break\n","            data = res.json()\n","            hits = data.get(\"hits\", [])\n","            if not hits:\n","                break\n","            for item in hits:\n","                relative_url = item.get(\"url\")\n","                if relative_url:\n","                    full_url = f\"https://www.leroymerlin.com.br{relative_url}\" if not relative_url.startswith(\"http\") else relative_url\n","                    if full_url not in links:\n","                        links.add(full_url)\n","                        contador_cat += 1\n","                        if contador_cat >= limite_por_categoria:\n","                            print(f\"⚠️ Limite de {limite_por_categoria} atingido para a categoria '{termo}'.\")\n","                            break\n","            if contador_cat >= limite_por_categoria:\n","                break\n","            if pagina >= data.get(\"nbPages\", 0) - 1:\n","                break\n","    return links\n","\n","print(\"\\n🔍 Coletando até 1 link por categoria via API Algolia...\")\n","todos_links = buscar_links_por_categoria(termos_busca, limite_por_categoria=1)\n","print(f\"✅ Total de links coletados: {len(todos_links)}\\n\")\n","\n","# ========================\n","# PARTE 3: EXTRAÇÃO DE DADOS DOS PRODUTOS\n","# ========================\n","def extrair_dados_produto(url):\n","    driver.get(url)\n","    try:\n","        wait.until(EC.presence_of_element_located((By.CSS_SELECTOR, \"h1\")))\n","    except TimeoutException:\n","        return {'URL': url, 'Erro': 'Timeout'}\n","\n","    dados = {'URL': url}\n","    dados['Nome'] = driver.find_element(By.CSS_SELECTOR, \"h1\").text if driver.find_elements(By.CSS_SELECTOR, \"h1\") else None\n","    dados['Código'] = url.split(\"_\")[-1] if \"_\" in url else None\n","\n","    preco_txt = None\n","    precos_candidatos = [\n","        '[data-cy=\"product-price\"]',\n","        '[data-cy=\"product-price-integer\"]',\n","        '[data-cy=\"product-price-sale\"]',\n","        '.price__sales',\n","        '.value__integer',\n","        '.price',\n","        '.price__value'\n","    ]\n","    for sel in precos_candidatos:\n","        elems = driver.find_elements(By.CSS_SELECTOR, sel)\n","        if elems:\n","            text = elems[0].text.strip()\n","            if text and text.lower() != \"grátis\":\n","                preco_txt = text\n","                break\n","\n","    if preco_txt:\n","        clean = preco_txt.replace(\"R$\", \"\").replace(\"/m²\", \"\").replace(\" \", \"\").replace(\".\", \"\").replace(\",\", \".\").strip()\n","        try:\n","            preco_val = float(clean)\n","            dados['Preço Promocional'] = f\"{preco_val:.2f}\".replace(\".\", \",\")\n","        except:\n","            dados['Preço Promocional'] = \"N/A\"\n","    else:\n","        dados['Preço Promocional'] = \"N/A\"\n","\n","    dados['Descrição'] = driver.find_element(By.CSS_SELECTOR, 'meta[name=\"description\"]').get_attribute(\"content\") if driver.find_elements(By.CSS_SELECTOR, 'meta[name=\"description\"]') else None\n","    dados['Imagem'] = driver.find_element(By.CSS_SELECTOR, 'meta[property=\"og:image\"]').get_attribute(\"content\") if driver.find_elements(By.CSS_SELECTOR, 'meta[property=\"og:image\"]') else \"N/A\"\n","\n","    specs = {}\n","    for tr in driver.find_elements(By.CSS_SELECTOR, 'table tr'):\n","        try:\n","            k = tr.find_element(By.CSS_SELECTOR, 'th').text.strip()\n","            v = tr.find_element(By.CSS_SELECTOR, 'td').text.strip()\n","            specs[k] = v\n","        except:\n","            continue\n","    dados['Especificações'] = \"\\n\".join(f\"{k}: {v}\" for k, v in specs.items())\n","    dados['Loja'] = \"Leroy Merlim\"\n","    return dados\n","\n","# ========================\n","# PARTE 4: COLETA DOS PRODUTOS\n","# ========================\n","todos = []\n","for i, link in enumerate(sorted(todos_links), 1):\n","    print(f\"🔍 {i}/{len(todos_links)} -> {link}\")\n","    try:\n","        dados = extrair_dados_produto(link)\n","        todos.append(dados)\n","    except Exception as err:\n","        print(\"Erro:\", err)\n","driver.quit()\n","\n","# ========================\n","# PARTE 5: SALVAR PLANILHA E CSV COM ORDEM DEFINIDA\n","# ========================\n","data_nome = datetime.now().strftime(\"%Y-%m-%d\")\n","pasta_base = \"leroymerelin_coleta\"\n","os.makedirs(pasta_base, exist_ok=True)\n","\n","arquivo_excel = f\"{pasta_base}/leroymerelin_{data_nome}.xlsx\"\n","arquivo_csv = f\"{pasta_base}/leroymerelin_{data_nome}.csv\"\n","\n","colunas_ordenadas = ['Código', 'Nome', 'Preço Promocional', 'Descrição', 'Especificações', 'Imagem', 'URL', 'Loja']\n","df = pd.DataFrame(todos)\n","df.drop(columns=[c for c in df.columns if c in ['Erro']], inplace=True, errors='ignore')\n","df = df[colunas_ordenadas]\n","df.to_excel(arquivo_excel, index=False)\n","df.to_csv(arquivo_csv, index=False, sep=\";\")\n","\n","print(f\"📄 Excel salvo em: {arquivo_excel}\")\n","print(f\"📄 CSV salvo em: {arquivo_csv}\")\n","\n","# ========================\n","# PARTE 6: BAIXAR IMAGENS E ZIPAR\n","# ========================\n","pasta_imagens = os.path.join(pasta_base, f\"imagens_leroymerelin_{data_nome}\")\n","os.makedirs(pasta_imagens, exist_ok=True)\n","\n","for _, r in df.iterrows():\n","    url_img = r['Imagem']\n","    cod = r['Código']\n","    if url_img and url_img != \"N/A\":\n","        for t in range(3):\n","            try:\n","                resp = requests.get(url_img, headers={\"User-Agent\":\"Mozilla/5.0\"}, timeout=10, stream=True)\n","                if resp.status_code == 200:\n","                    with open(f\"{pasta_imagens}/{cod}.png\", \"wb\") as f:\n","                        for cb in resp.iter_content(1024):\n","                            f.write(cb)\n","                    break\n","            except:\n","                time.sleep(2)\n","\n","zipname = os.path.join(pasta_base, f\"imagens_leroymerelin_{data_nome}.zip\")\n","with zipfile.ZipFile(zipname, \"w\", zipfile.ZIP_DEFLATED) as z:\n","    for fn in os.listdir(pasta_imagens):\n","        z.write(os.path.join(pasta_imagens, fn), fn)\n","print(f\"📦 Imagens zipadas em: {zipname}\")\n"]},{"cell_type":"code","source":[],"metadata":{"id":"mH0xB7qOvmF6"},"execution_count":null,"outputs":[]}]}