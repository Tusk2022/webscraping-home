\n","\n","    # Atualizar cada elemento antes de acessar\n","    for i in range(len(elementos)):\n","        try:\n","            produto = driver.find_elements(By.CSS_SELECTOR, \"div.vtex-search-result-3-x-galleryItem a\")[i]\n","            href = produto.get_attribute(\"href\")\n","            if href and href not in links:\n","                links.append(href)\n","        except Exception as e:\n","            print(f\"⚠️ Erro ao pegar link do produto {i}: {e}\")\n","            continue\n","\n","    print(f\"➡️ Total acumulado: {len(links)}\")\n","    pagina += 1\n","    time.sleep(2)\n","\n","driver.quit()\n","\n","# Função para extrair detalhes\n","def extrair_detalhes_produto(url):\n","    headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","    try:\n","        response = requests.get(url, headers=headers, timeout=10)\n","        if response.status_code != 200:\n","            return None\n","        soup = BeautifulSoup(response.text, \"html.parser\")\n","\n","        nome = soup.find(\"h1\", class_=\"vtex-store-components-3-x-productNameContainer\")\n","        nome = nome.text.strip() if nome else \"N/A\"\n","\n","        codigo = soup.find(\"span\", class_=\"vtex-product-identifier-0-x-product-identifier__value\")\n","        codigo = codigo.text.strip() if codigo else \"0\"\n","\n","        preco_original = soup.select_one(\".vtex-product-price-1-x-listPriceWithUnitMultiplier strike\")\n","        preco_original = preco_original.text.strip() if preco_original else \"N/A\"\n","\n","        preco_promocional = soup.select_one(\".telhanorte-telha-store-app-1-x-preco-best-un\")\n","        preco_promocional = preco_promocional.text.strip() if preco_promocional else \"N/A\"\n","\n","        preco_m2 = soup.select_one(\".telhanorte-telha-store-app-1-x-preco-m2\")\n","        preco_m2 = preco_m2.text.strip() if preco_m2 else \"N/A\"\n","\n","        imagem = soup.find(\"img\", class_=\"telhanorte-telha-store-app-1-x-imagem-destaque\")\n","        imagem = imagem['src'] if imagem else \"N/A\"\n","\n","        return [nome, codigo, preco_original, preco_promocional, preco_m2, imagem, url]\n","    except Exception as e:\n","        print(f\"⚠️ Erro ao processar {url}: {e}\")\n","        return None\n","\n","# Coletar detalhes de todos os produtos\n","dados = []\n","for i, link in enumerate(links):\n","    print(f\"[{i+1}/{len(links)}] Coletando: {link}\")\n","    resultado = extrair_detalhes_produto(link)\n","    if resultado:\n","        dados.append(resultado)\n","\n","# Salvar resultados\n","df = pd.DataFrame(dados, columns=[\n","    \"Nome\", \"Código\", \"Preço Original\", \"Preço Promocional\", \"Preço por m²\", \"Imagem\", \"URL\"\n","])\n","df.to_csv(\"telhanorte_porcelanatos_detalhado.csv\", index=False)\n","df.head()\n"]}]}