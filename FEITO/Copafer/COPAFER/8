{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM4T1V5Rj7drLsuv2RawTYi"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"7KYSLk3CAUht"},"outputs":[],"source":["import requests\n","import pandas as pd\n","import time\n","from bs4 import BeautifulSoup\n","import os\n","import zipfile\n","from datetime import datetime\n","\n","# Configurações\n","headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","limite = 50\n","pagina = 0\n","todos_produtos = []\n","\n","while True:\n","    url = f\"https://www.copafer.com.br/api/catalog_system/pub/products/search/pisos-e-revestimentos?O=OrderByReleaseDateDESC&_from={pagina * limite}&_to={(pagina + 1) * limite - 1}\"\n","    print(f\"Coletando página {pagina + 1}...\")\n","\n","    resposta = requests.get(url, headers=headers)\n","    if resposta.status_code not in [200, 206]:\n","        print(f\"Erro ao acessar a API: {resposta.status_code}\")\n","        break\n","\n","    produtos = resposta.json()\n","    if not produtos:\n","        print(\"Nenhum produto encontrado. Fim da coleta.\")\n","        break\n","\n","    for produto in produtos:\n","        try:\n","            nome = produto.get(\"productName\", \"\")\n","            raw_link = produto.get(\"link\", \"\")\n","            link = raw_link if raw_link.startswith(\"http\") else \"https://www.copafer.com.br\" + raw_link\n","            codigo = produto.get(\"productReference\", \"\")\n","            preco_promocional = produto[\"items\"][0][\"sellers\"][0][\"commertialOffer\"][\"Price\"]\n","            preco_original = produto[\"items\"][0][\"sellers\"][0][\"commertialOffer\"][\"ListPrice\"]\n","            preco_m2 = round(preco_promocional / produto[\"items\"][0].get(\"unitMultiplier\", 1), 2)\n","\n","            descricao_html = produto.get(\"description\", \"\")\n","            descricao = BeautifulSoup(descricao_html, \"html.parser\").get_text(separator=\"\\n\").strip()\n","\n","            marca = produto.get(\"brand\", \"\")\n","            especificacoes = f\"Marca: {marca}\"\n","\n","            imagem = produto[\"items\"][0][\"images\"][0][\"imageUrl\"]\n","            loja = \"Copafer\"\n","\n","            todos_produtos.append({\n","                \"Código\": codigo,\n","                \"Nome\": nome,\n","                \"Preço Promocional\": preco_promocional,\n","                \"Preço Original\": preco_original,\n","                \"Preço por m²\": preco_m2,\n","                \"Especificações\": especificacoes,\n","                \"Descrição\": descricao,\n","                \"Imagem\": imagem,\n","                \"URL\": link,\n","                \"Loja\": loja\n","            })\n","\n","        except Exception as e:\n","            print(f\"Erro ao processar produto: {e}\")\n","\n","    pagina += 1\n","    time.sleep(0.5)\n","\n","# Pasta base e data\n","data_hoje = datetime.now().strftime(\"%Y-%m-%d\")\n","pasta_base = \"saida_copafer\"\n","os.makedirs(pasta_base, exist_ok=True)\n","\n","# Salvar CSV e Excel\n","csv_path = os.path.join(pasta_base, f\"produtos_pisos_revestimentos_copafer_{data_hoje}.csv\")\n","xlsx_path = os.path.join(pasta_base, f\"produtos_pisos_revestimentos_copafer_{data_hoje}.xlsx\")\n","\n","df = pd.DataFrame(todos_produtos)\n","df.to_csv(csv_path, index=False, encoding=\"utf-8-sig\")\n","df.to_excel(xlsx_path, index=False)\n","\n","# Baixar imagens com retry\n","images_dir = os.path.join(pasta_base, f\"imagens_copafer_{data_hoje}\")\n","os.makedirs(images_dir, exist_ok=True)\n","\n","for _, row in df.iterrows():\n","    codigo = row[\"Código\"]\n","    img_url = row[\"Imagem\"]\n","    if img_url != \"N/A\":\n","        tentativas = 0\n","        sucesso = False\n","        while tentativas < 3 and not sucesso:\n","            try:\n","                resp = requests.get(img_url, stream=True, timeout=10)\n","                if resp.status_code == 200:\n","                    imagem_path = os.path.join(images_dir, f\"{codigo}.png\")\n","                    with open(imagem_path, \"wb\") as f:\n","                        for chunk in resp.iter_content(1024):\n","                            f.write(chunk)\n","                    sucesso = True\n","                else:\n","                    print(f\"❌ Erro ao baixar imagem para {codigo}: Status {resp.status_code}\")\n","            except Exception as e:\n","                print(f\"❌ Erro ao baixar imagem para {codigo}: {e}\")\n","            finally:\n","                if not sucesso:\n","                    tentativas += 1\n","                    if tentativas < 3:\n","                        print(f\"🔁 Tentando novamente {codigo} (tentativa {tentativas + 1})...\")\n","                        time.sleep(5)\n","\n","# Compactar imagens em ZIP\n","zip_filename = os.path.join(pasta_base, f\"imagens_copafer_{data_hoje}.zip\")\n","with zipfile.ZipFile(zip_filename, \"w\", zipfile.ZIP_DEFLATED) as zipf:\n","    for filename in os.listdir(images_dir):\n","        zipf.write(os.path.join(images_dir, filename), filename)\n","\n","# Mensagens finais\n","print(f\"📄 CSV salvo: {csv_path}\")\n","print(f\"📊 Excel salvo: {xlsx_path}\")\n","print(f\"📦 Imagens compactadas: {zip_filename}\")"]}]}