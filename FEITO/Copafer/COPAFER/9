16/portas-e-janelas/portas-e-janelas_copafer.xlsx\n","   📦 Imagens ZIP: saida_copafer_2025-06-16/portas-e-janelas/imagens_portas-e-janelas.zip\n","\n","🔍 Coletando categoria: tintas-e-acessorios\n","   📄 Página 1...\n","✅ Categoria 'tintas-e-acessorios' finalizada com 10 produtos.\n","   📄 CSV salvo: saida_copafer_2025-06-16/tintas-e-acessorios/tintas-e-acessorios_copafer.csv\n","   📊 Excel salvo: saida_copafer_2025-06-16/tintas-e-acessorios/tintas-e-acessorios_copafer.xlsx\n","   📦 Imagens ZIP: saida_copafer_2025-06-16/tintas-e-acessorios/imagens_tintas-e-acessorios.zip\n","\n","🔍 Coletando categoria: utilidades-domesticas\n","   📄 Página 1...\n","✅ Categoria 'utilidades-domesticas' finalizada com 10 produtos.\n","   📄 CSV salvo: saida_copafer_2025-06-16/utilidades-domesticas/utilidades-domesticas_copafer.csv\n","   📊 Excel salvo: saida_copafer_2025-06-16/utilidades-domesticas/utilidades-domesticas_copafer.xlsx\n","   📦 Imagens ZIP: saida_copafer_2025-06-16/utilidades-domesticas/imagens_utilidades-domesticas.zip\n"]}],"source":["import requests\n","import pandas as pd\n","import time\n","from bs4 import BeautifulSoup\n","import os\n","import zipfile\n","from datetime import datetime\n","from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE\n","\n","# Função para remover caracteres ilegais do Excel\n","def remover_caracteres_invalidos(texto):\n","    if not isinstance(texto, str):\n","        return texto\n","    return ILLEGAL_CHARACTERS_RE.sub(\"\", texto)\n","\n","# Categorias da Copafer\n","categorias = [\n","    \"banheiro-e-cozinha\", \"especial\", \"ferragens\", \"ferramentas\", \"iluminacao\",\n","    \"jardim-e-lazer\", \"materiais-eletricos\", \"material-hidraulico\", \"materiais-para-construcao\",\n","    \"material-automotivo\", \"pet-shop\", \"pisos-e-revestimentos\", \"portas-e-janelas\",\n","    \"tintas-e-acessorios\", \"utilidades-domesticas\"\n","]\n","\n","# Configurações\n","headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","limite_api = 50\n","limite_por_categoria = 10\n","data_hoje = datetime.now().strftime(\"%Y-%m-%d\")\n","pasta_base = f\"saida_copafer_{data_hoje}\"\n","os.makedirs(pasta_base, exist_ok=True)\n","\n","for categoria in categorias:\n","    print(f\"\\n🔍 Coletando categoria: {categoria}\")\n","    todos_produtos = []\n","    pagina = 0\n","    coletados = 0\n","\n","    while coletados < limite_por_categoria:\n","        url = f\"https://www.copafer.com.br/api/catalog_system/pub/products/search/{categoria}?O=OrderByReleaseDateDESC&_from={pagina * limite_api}&_to={(pagina + 1) * limite_api - 1}\"\n","        print(f\"   📄 Página {pagina + 1}...\")\n","\n","        resposta = requests.get(url, headers=headers)\n","        if resposta.status_code not in [200, 206]:\n","            print(f\"   ❌ Erro: {resposta.status_code}\")\n","            break\n","\n","        produtos = resposta.json()\n","        if not produtos:\n","            print(\"   ✅ Fim da categoria.\")\n","            break\n","\n","        for produto in produtos:\n","            if coletados >= limite_por_categoria:\n","                break\n","            try:\n","                nome = produto.get(\"productName\", \"\").strip()\n","                raw_link = produto.get(\"link\", \"\")\n","                link = raw_link if raw_link.startswith(\"http\") else \"https://www.copafer.com.br\" + raw_link\n","                codigo = produto.get(\"productReference\", \"\")\n","                preco_promocional = produto[\"items\"][0][\"sellers\"][0][\"commertialOffer\"][\"Price\"]\n","                preco_original = produto[\"items\"][0][\"sellers\"][0][\"commertialOffer\"][\"ListPrice\"]\n","                preco_m2 = round(preco_promocional / produto[\"items\"][0].get(\"unitMultiplier\", 1), 2)\n","\n","                descricao_html = produto.get(\"description\", \"\")\n","                descricao_limpa = BeautifulSoup(descricao_html, \"html.parser\").get_text(separator=\" \").strip()\n","                descricao_limpa = ' '.join(descricao_limpa.split())\n","\n","                marca = produto.get(\"brand\", \"\").strip()\n","                especificacoes = f\"Marca: {marca}\"\n","\n","                imagem = produto[\"items\"][0][\"images\"][0][\"imageUrl\"]\n","                loja = \"Copafer\"\n","\n","                todos_produtos.append({\n","                    \"Código\": codigo,\n","                    \"Nome\": nome,\n","                    \"Marca\": marca,\n","                    \"Preço Promocional\": preco_promocional,\n","                    \"Preço Original\": preco_original,\n","                    \"Preço por m²\": preco_m2,\n","                    \"Especificações\": especificacoes,\n","                    \"Descrição\": descricao_limpa,\n","                    \"Imagem\": imagem,\n","                    \"URL\": link,\n","                    \"Categoria\": categoria,\n","                    \"Loja\": loja\n","                })\n","                coletados += 1\n","\n","            except Exception as e:\n","                print(f\"   ⚠️ Erro ao processar produto: {e}\")\n","\n","        pagina += 1\n","        time.sleep(0.5)\n","\n","    # Criar pasta por categoria\n","    pasta_categoria = os.path.join(pasta_base, categoria.replace(\"/\", \"_\"))\n","    os.makedirs(pasta_categoria, exist_ok=True)\n","\n","    # Salvar CSV e Excel\n","    csv_path = os.path.join(pasta_categoria, f\"{categoria}_copafer.csv\")\n","    xlsx_path = os.path.join(pasta_categoria, f\"{categoria}_copafer.xlsx\")\n","    df = pd.DataFrame(todos_produtos)\n","    df.to_csv(csv_path, index=False, encoding=\"utf-8-sig\")\n","\n","    # Remove caracteres inválidos antes de salvar em Excel\n","    df_limpo = df.applymap(remover_caracteres_invalidos)\n","    df_limpo.to_excel(xlsx_path, index=False)\n","\n","    # Baixar imagens\n","    images_dir = os.path.join(pasta_categoria, \"imagens\")\n","    os.makedirs(images_dir, exist_ok=True)\n","\n","    for _, row in df.iterrows():\n","        codigo = row[\"Código\"]\n","        img_url = row[\"Imagem\"]\n","        if img_url != \"N/A\":\n","            tentativas = 0\n","            sucesso = False\n","            while tentativas < 3 and not sucesso:\n","                try:\n","                    resp = requests.get(img_url, stream=True, timeout=10)\n","                    if resp.status_code == 200:\n","                        imagem_path = os.path.join(images_dir, f\"{codigo}.png\")\n","                        with open(imagem_path, \"wb\") as f:\n","                            for chunk in resp.iter_content(1024):\n","                                f.write(chunk)\n","                        sucesso = True\n","                    else:\n","                        print(f\"❌ Erro ao baixar imagem de {codigo}\")\n","                except Exception as e:\n","                    print(f\"❌ Exceção ao baixar imagem: {e}\")\n","                finally:\n","                    if not sucesso:\n","                        tentativas += 1\n","                        time.sleep(5)\n","\n","    # Compactar imagens\n","    zip_filename = os.path.join(pasta_categoria, f\"imagens_{categoria}.zip\")\n","    with zipfile.ZipFile(zip_filename, \"w\", zipfile.ZIP_DEFLATED) as zipf:\n","        for filename in os.listdir(images_dir):\n","            zipf.write(os.path.join(images_dir, filename), filename)\n","\n","    print(f\"✅ Categoria '{categoria}' finalizada com {len(todos_produtos)} produtos.\")\n","    print(f\"   📄 CSV salvo: {csv_path}\")\n","    print(f\"   📊 Excel salvo: {xlsx_path}\")\n","    print(f\"   📦 Imagens ZIP: {zip_filename}\")\n"]}]}