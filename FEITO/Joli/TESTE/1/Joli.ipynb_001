{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNUwCDNz9LJKlkaBrroL+D2"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["!pip install selenium"],"metadata":{"id":"aLqVA3BUVBG7"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from selenium import webdriver\n","from selenium.webdriver.common.by import By\n","from selenium.webdriver.support.ui import WebDriverWait\n","from selenium.webdriver.support import expected_conditions as EC\n","from selenium.common.exceptions import StaleElementReferenceException, TimeoutException\n","\n","# Inicialize o WebDriver\n","opções = webdriver.ChromeOptions()\n","opções.add_argument('--headless')\n","opções.add_argument('--no-sandbox')\n","opções.add_argument('--disable-dev-shm-usage')\n","\n","driver = webdriver.Chrome(options=opções)\n","\n","# Navegue até o site\n","driver.get('https://www.joli.com.br/chuveiros-e-aquecedores')\n","\n","# Encontre os produtos\n","produtos = []\n","\n","while True:\n","    # Encontre os produtos na página atual\n","    produtos_atual = WebDriverWait(driver, 10).until(\n","        EC.presence_of_all_elements_located((By.CSS_SELECTOR, '.vtex-search-result-3-x-galleryItem'))\n","    )\n","\n","    # Adicione os produtos à lista\n","    for produto in produtos_atual:\n","        try:\n","            # Tente acessar o texto do produto\n","            texto_produto = produto.text\n","            produtos.append(texto_produto)\n","        except StaleElementReferenceException:\n","            # Se o elemento não estiver mais presente, ignore-o\n","            continue\n","\n","    # Verifique se há mais produtos para carregar\n","    try:\n","        # Clique no botão \"Carregar mais\"\n","        carregar_mais = WebDriverWait(driver, 10).until(\n","            EC.element_to_be_clickable((By.CSS_SELECTOR, '.vtex-search-result-3-x-loadMore'))\n","        )\n","        carregar_mais.click()\n","\n","        # Espere que a página seja recarregada\n","        WebDriverWait(driver, 10).until(\n","            EC.staleness_of(carregar_mais)\n","        )\n","    except TimeoutException:\n","        # Se não houver mais produtos para carregar, saia do loop\n","        break\n","\n","# Imprima os produtos\n","for produto in produtos:\n","    print(produto)\n","\n","# Feche o driver\n","driver.quit()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"UUXmbyOEYIK6","executionInfo":{"status":"ok","timestamp":1719503218832,"user_tz":180,"elapsed":17809,"user":{"displayName":"Rodrigo Barbosa","userId":"12195881671939784319"}},"outputId":"29365d25-5233-4e2d-bde9-565bf1b4d615"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["12%\n","OFF\n","Ofertas\n","CHUVEIRO BELLA DUCHA ULTRA 4 TEMPERATURAS BRANCA 220V 6800W LORENZETTI\n","R$ 92,90\n","R$ 81,99\n","COMPRA RÁPIDA\n","28%\n","OFF\n","Ofertas\n","DUCHA SUPER DUCHA 4T 220V 6800W BRANCO FAME\n","R$ 75,90\n","R$ 54,99\n","COMPRA RÁPIDA\n","12%\n","OFF\n","Ofertas\n","CHUVEIRO BELLA DUCHA ULTRA 4 TEMPERATURAS AZUL 220V 6800W LORENZETTI\n","R$ 92,90\n","R$ 81,99\n","COMPRA RÁPIDA\n","28%\n","OFF\n","Ofertas\n","DUCHA SUPER DUCHA 4T 127V 5400W BRANCO FAME\n","R$ 75,90\n","R$ 54,99\n","COMPRA RÁPIDA\n","20%\n","OFF\n","Ofertas\n","CHUVEIRO LOREN SHOWER ULTRA MULTITEMPERATURAS 220V 7500W LORENZETTI\n","R$ 139,90\n","R$ 111,99\n","2x de \n","R$ 55,99\n"," sem juros\n","COMPRA RÁPIDA\n","20%\n","OFF\n","DUCHA STILO 220V 5400W PRETO FORUSI\n","R$ 49,90\n","R$ 39,99\n","COMPRA RÁPIDA\n"]}]}]}