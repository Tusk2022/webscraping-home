{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMN857TByZUiJmi5Jko+zaR"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"la7RNiDNaLTA"},"outputs":[],"source":["!pip install aiohttp nest_asyncio pandas tqdm > /dev/null\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import requests, re, aiohttp, asyncio, nest_asyncio, pandas as pd, json, os\n","from bs4 import BeautifulSoup\n","from tqdm import tqdm\n","import time\n","\n","nest_asyncio.apply()\n","\n","base_url = \"https://www.promofarma.com.br\"\n","headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","\n","max_retries_page = 3\n","sleep_time = 5\n","\n","# Caminho para salvar o JSON no Drive\n","drive_json_path = \"/content/drive/MyDrive/promofarma_api_urls.json\"\n","\n","# ============================\n","# Categorias disponíveis\n","# ============================\n","categorias_dict = {\n","    1: (\"Todas as categorias\", [\n","        \"/medicamentos\",\n","        \"/beleza-e-higiene\",\n","        \"/saude-e-bem-estar\",\n","        \"/mamae-e-bebe\",\n","        \"/vitaminas-e-suplementos\"\n","    ]),\n","    2: (\"Medicamentos\", [\"/medicamentos\"]),\n","    3: (\"Beleza e Higiene\", [\"/beleza-e-higiene\"]),\n","    4: (\"Saúde e Bem Estar\", [\"/saude-e-bem-estar\"]),\n","    5: (\"Mamãe e Bebê\", [\"/mamae-e-bebe\"]),\n","    6: (\"Vitaminas e Suplementos\", [\"/vitaminas-e-suplementos\"])\n","}\n","\n","# ============================\n","# Menu de categorias\n","# ============================\n","print(\"Escolha a categoria para coleta:\")\n","for key, value in categorias_dict.items():\n","    print(f\"[{key}] {value[0]}\")\n","\n","while True:\n","    try:\n","        escolha = int(input(\"Digite o número da opção desejada: \"))\n","        if escolha in categorias_dict:\n","            break\n","        else:\n","            print(\"Opção inválida. Tente novamente.\")\n","    except:\n","        print(\"Digite um número válido.\")\n","\n","categorias = categorias_dict[escolha][1]\n","print(f\"\\nVocê selecionou: {categorias_dict[escolha][0]}\\n\")\n","\n","# ============================\n","# Função para coletar links da categoria\n","# ============================\n","def coletar_links_categoria(url):\n","    links = []\n","    page = 1\n","    while True:\n","        success = False\n","        for attempt in range(max_retries_page):\n","            print(f\"🔎 Tentativa {attempt+1} - Página {page}\")\n","            try:\n","                resp = requests.get(f\"{url}?page={page}\", headers=headers, timeout=10)\n","                if resp.status_code != 200:\n","                    print(f\"❌ Erro HTTP {resp.status_code}\")\n","                    time.sleep(2)\n","                    continue\n","                soup = BeautifulSoup(resp.text, \"html.parser\")\n","                page_links = [a[\"href\"] for a in soup.select(\"a[href*='/p']\")]\n","                if page_links:\n","                    links.extend(page_links)\n","                    success = True\n","\n","                    # Mostrar links desta página em tempo real\n","                    print(f\"\\n🔗 Links coletados na página {page}:\")\n","                    for link in page_links:\n","                        full_link = base_url + link if link.startswith(\"/\") else link\n","                        print(full_link)\n","                    print(f\"✅ Total de links até agora: {len(links)}\\n\")\n","\n","                    break\n","            except Exception as e:\n","                print(f\"⚠️ Erro na requisição: {e}\")\n","            time.sleep(sleep_time)\n","        if not success:\n","            print(f\"🚨 Não conseguiu coletar produtos na página {page}, avançando...\")\n","        page += 1\n","        if page > 1000:\n","            break\n","    return list(set(links))\n","\n","# ============================\n","# Função para extrair productId\n","# ============================\n","def extrair_product_id(produto_url, max_retries=3):\n","    for attempt in range(max_retries):\n","        try:\n","            resp = requests.get(produto_url, headers=headers, timeout=10)\n","            if resp.status_code != 200:\n","                time.sleep(1)\n","                continue\n","            match = re.search(r'\"productId\":\"(\\d+)\"', resp.text)\n","            if match:\n","                return match.group(1)\n","        except:\n","            time.sleep(1)\n","    return None\n","\n","# ============================\n","# Ler APIs antigas se existir\n","# ============================\n","if os.path.exists(drive_json_path):\n","    with open(drive_json_path, \"r\") as f:\n","        saved_api_urls = json.load(f)\n","else:\n","    saved_api_urls = []\n","\n","# ============================\n","# Coletar links novos para cada categoria selecionada\n","# ============================\n","produto_links = []\n","for cat in categorias:\n","    categoria_url = base_url + cat\n","    print(f\"\\n=== Coletando categoria: {cat} ===\")\n","    links = coletar_links_categoria(categoria_url)\n","    produto_links.extend(links)\n","\n","produto_links = list(set(produto_links))\n","print(f\"\\n✅ Total de links coletados em todas as categorias selecionadas: {len(produto_links)}\\n\")\n","\n","# ============================\n","# Pergunta quantidade para baixar\n","# ============================\n","print(\"Escolha a quantidade de produtos para baixar:\")\n","print(\"[1] Todos os produtos\")\n","print(\"[2] Quantidade escolhida pelo usuário\")\n","\n","while True:\n","    try:\n","        escolha_qtd = int(input(\"Digite o número da opção desejada: \"))\n","        if escolha_qtd == 1:\n","            produto_links = produto_links  # todos\n","            break\n","        elif escolha_qtd == 2:\n","            qtd = int(input(\"Informe a quantidade de produtos que deseja baixar: \"))\n","            produto_links = produto_links[:qtd]\n","            break\n","        else:\n","            print(\"Opção inválida. Tente novamente.\")\n","    except:\n","        print(\"Digite um número válido.\")\n","\n","print(f\"\\n✅ Serão processados {len(produto_links)} produtos.\\n\")\n","\n","# ============================\n","# Extrair productIds e atualizar JSON de APIs\n","# ============================\n","new_product_ids = []\n","for link in produto_links:\n","    url = base_url + link if link.startswith(\"/\") else link\n","    pid = extrair_product_id(url)\n","    if pid:\n","        api_url = f\"{base_url}/api/catalog_system/pub/products/search?fq=productId:{pid}\"\n","        if api_url not in saved_api_urls:\n","            saved_api_urls.append(api_url)\n","            new_product_ids.append(pid)\n","    time.sleep(sleep_time)\n","\n","# Salvar APIs atualizadas no Drive\n","with open(drive_json_path, \"w\") as f:\n","    json.dump(saved_api_urls, f, indent=2)\n","print(f\"💾 Total de APIs salvas: {len(saved_api_urls)}\")\n","\n","# ============================\n","# Baixar dados de todas as APIs (novas + antigas)\n","# ============================\n","async def fetch(session, url):\n","    try:\n","        async with session.get(url, headers=headers) as resp:\n","            if resp.status != 200:\n","                return None\n","            return await resp.json()\n","    except:\n","        return None\n","\n","async def baixar_produtos(api_urls):\n","    produtos = []\n","    async with aiohttp.ClientSession() as session:\n","        tasks = [fetch(session, url) for url in api_urls]\n","        for f in tqdm(asyncio.as_completed(tasks), total=len(tasks)):\n","            result = await f\n","            if result:\n","                produtos.extend(result)\n","    return produtos\n","\n","produtos = asyncio.run(baixar_produtos(saved_api_urls))\n","print(f\"📦 Total de produtos coletados: {len(produtos)}\")\n","\n","# ============================\n","# Criar CSV final\n","# ============================\n","dados = []\n","for p in produtos:\n","    try:\n","        item = p[\"items\"][0]\n","        oferta = item[\"sellers\"][0][\"commertialOffer\"]\n","        dados.append({\n","            \"id\": p[\"productId\"],\n","            \"nome\": p[\"productName\"],\n","            \"marca\": p.get(\"brand\", \"\"),\n","            \"preco\": oferta[\"Price\"],\n","            \"preco_de\": oferta[\"ListPrice\"],\n","            \"estoque\": oferta[\"AvailableQuantity\"],\n","            \"ean\": item.get(\"ean\", \"\"),\n","            \"link\": base_url + p[\"link\"],\n","            \"imagem\": item[\"images\"][0][\"imageUrl\"] if item[\"images\"] else \"\"\n","        })\n","    except:\n","        continue\n","\n","df = pd.DataFrame(dados)\n","csv_path = \"/content/drive/MyDrive/promofarma_produtos.csv\"\n","df.to_csv(csv_path, index=False, encoding=\"utf-8-sig\")\n","print(f\"✅ CSV final salvo em: {csv_path}\")\n"]}]}