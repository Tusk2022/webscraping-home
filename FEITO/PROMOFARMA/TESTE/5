{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM5Wl5HEu9ZSbUqDZKL8m4Z"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"NiRU_QD8aGe8"},"outputs":[],"source":["!pip install aiohttp nest_asyncio pandas tqdm > /dev/null\n","\n","import requests, re, aiohttp, asyncio, nest_asyncio, pandas as pd\n","from bs4 import BeautifulSoup\n","from tqdm import tqdm\n","import time\n","\n","nest_asyncio.apply()\n","\n","base_url = \"https://www.promofarma.com.br\"\n","headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","\n","# URLs das categorias\n","categorias = [\n","    \"/medicamentos\",\n","    \"/beleza-e-higiene\",\n","    \"/saude-e-bem-estar\",\n","    \"/mamae-e-bebe\",\n","    \"/vitaminas-e-suplementos\"\n","]\n","\n","# ============================\n","# PASSO 1: Coletar links de produtos de todas as categorias\n","# ============================\n","def coletar_links_categoria(url):\n","    links = []\n","    page = 1\n","    while True:\n","        print(f\"🔎 Coletando página {page} da categoria {url}...\")\n","        resp = requests.get(f\"{url}?page={page}\", headers=headers)\n","        if resp.status_code != 200:\n","            print(\"❌ Erro HTTP\", resp.status_code)\n","            break\n","        soup = BeautifulSoup(resp.text, \"html.parser\")\n","        page_links = [a[\"href\"] for a in soup.select(\"a[href*='/p']\")]\n","        if not page_links:  # sem mais produtos\n","            break\n","        links.extend(page_links)\n","        page += 1\n","        time.sleep(1.5)  # delay de 1,5s entre páginas\n","    return list(set(links))  # remove duplicados\n","\n","produto_links = []\n","for categoria in categorias:\n","    categoria_url = base_url + categoria\n","    produto_links.extend(coletar_links_categoria(categoria_url))\n","\n","print(f\"✅ Total de produtos encontrados: {len(produto_links)}\")\n","\n","# ============================\n","# PASSO 2: Extrair productId real de cada página com delay\n","# ============================\n","def extrair_product_id(produto_url):\n","    resp = requests.get(produto_url, headers=headers)\n","    if resp.status_code != 200:\n","        return None\n","    match = re.search(r'\"productId\":\"(\\d+)\"', resp.text)\n","    if match:\n","        return match.group(1)\n","    return None\n","\n","product_ids = []\n","for link in produto_links:\n","    url = base_url + link if link.startswith(\"/\") else link\n","    pid = extrair_product_id(url)\n","    if pid:\n","        product_ids.append(pid)\n","    time.sleep(1.5)  # delay de 1,5s entre requisições\n","\n","print(f\"🔑 Total de IDs encontrados: {len(product_ids)}\")\n","\n","# ============================\n","# PASSO 3: Montar URLs da API\n","# ============================\n","api_urls = [f\"{base_url}/api/catalog_system/pub/products/search?fq=productId:{pid}\" for pid in product_ids]\n","print(\"Exemplo de URL da API:\", api_urls[0] if api_urls else \"Nenhuma\")\n","\n","# ============================\n","# PASSO 4: Baixar JSONs em paralelo\n","# ============================\n","async def fetch(session, url):\n","    try:\n","        async with session.get(url, headers=headers) as resp:\n","            if resp.status != 200:\n","                return None\n","            return await resp.json()\n","    except:\n","        return None\n","\n","async def baixar_produtos(api_urls):\n","    produtos = []\n","    async with aiohttp.ClientSession() as session:\n","        tasks = [fetch(session, url) for url in api_urls]\n","        for f in tqdm(asyncio.as_completed(tasks), total=len(tasks)):\n","            result = await f\n","            if result:\n","                produtos.extend(result)\n","    return produtos\n","\n","produtos = asyncio.run(baixar_produtos(api_urls))\n","print(f\"📦 Total de produtos coletados: {len(produtos)}\")\n","\n","# ============================\n","# PASSO 5: Transformar em CSV\n","# ============================\n","dados = []\n","for p in produtos:\n","    try:\n","        item = p[\"items\"][0]\n","        oferta = item[\"sellers\"][0][\"commertialOffer\"]\n","        dados.append({\n","            \"id\": p[\"productId\"],\n","            \"nome\": p[\"productName\"],\n","            \"marca\": p.get(\"brand\", \"\"),\n","            \"preco\": oferta[\"Price\"],\n","            \"preco_de\": oferta[\"ListPrice\"],\n","            \"estoque\": oferta[\"AvailableQuantity\"],\n","            \"ean\": item.get(\"ean\", \"\"),\n","            \"link\": base_url + p[\"link\"],\n","            \"imagem\": item[\"images\"][0][\"imageUrl\"] if item[\"images\"] else \"\"\n","        })\n","    except:\n","        continue\n","\n","df = pd.DataFrame(dados)\n","df.to_csv(\"produtos_de_todas_as_categorias.csv\", index=False, encoding=\"utf-8-sig\")\n","df.head()\n"]}]}