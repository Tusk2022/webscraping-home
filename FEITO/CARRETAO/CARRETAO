{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMoIHt7Y4QwbPH3VX/2rg2v"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"WcD2X5MyY0wh"},"outputs":[],"source":["import os\n","import pandas as pd\n","import requests\n","from bs4 import BeautifulSoup\n","from datetime import datetime\n","import zipfile\n","import time\n","\n","# ========================\n","# Funções de coleta\n","# ========================\n","\n","def coletar_links_categoria(url):\n","    \"\"\"Coleta todos os links de produtos de uma categoria.\"\"\"\n","    links = []\n","    try:\n","        resposta = requests.get(url, timeout=10)\n","        resposta.raise_for_status()\n","        soup = BeautifulSoup(resposta.text, \"html.parser\")\n","\n","        for a in soup.select(\"a\"):\n","            href = a.get(\"href\")\n","            if href and \"/produto/\" in href:\n","                links.append(href)\n","    except Exception as e:\n","        print(f\"❌ Erro ao coletar links da categoria: {e}\")\n","    return list(set(links))  # remove duplicados\n","\n","\n","def extrair_dados_produto(link, categoria, indice):\n","    \"\"\"Extrai dados de um produto individual.\"\"\"\n","    try:\n","        resposta = requests.get(link, timeout=10)\n","        resposta.raise_for_status()\n","        soup = BeautifulSoup(resposta.text, \"html.parser\")\n","\n","        codigo = f\"COD-{indice}\"\n","        nome = soup.find(\"h1\").get_text(strip=True) if soup.find(\"h1\") else \"\"\n","        preco = soup.find(\"span\", class_=\"PrecoPrincipal\")\n","        preco = preco.get_text(strip=True) if preco else \"\"\n","        descricao = soup.find(\"div\", class_=\"descricao\")\n","        descricao = descricao.get_text(strip=True) if descricao else \"\"\n","        imagem = soup.find(\"img\")[\"src\"] if soup.find(\"img\") else \"\"\n","\n","        return [codigo, nome, preco, descricao, imagem, link, \"Minha Loja\", categoria]\n","    except Exception as e:\n","        print(f\"❌ Erro ao extrair produto {indice} ({link}): {e}\")\n","        return None\n","\n","# ========================\n","# Configurações de pastas\n","# ========================\n","data_hoje = datetime.now().strftime(\"%Y-%m-%d\")\n","pasta_base = f\"{data_hoje}_coleta\"\n","pasta_backup = os.path.join(pasta_base, \"backup\")\n","\n","os.makedirs(pasta_backup, exist_ok=True)\n","\n","# ========================\n","# Categorias para coleta\n","# ========================\n","categorias_urls = {\n","    \"categoria1\": \"https://www.exemplo.com/categoria1\",\n","    \"categoria2\": \"https://www.exemplo.com/categoria2\",\n","}\n","\n","# ========================\n","# Loop de coleta\n","# ========================\n","for categoria, url in categorias_urls.items():\n","    print(f\"\\n===== CATEGORIA: {categoria} =====\")\n","    links = coletar_links_categoria(url)\n","    print(f\"🔗 Total de produtos encontrados: {len(links)}\")\n","\n","    todos = []\n","    for i, link in enumerate(links, 1):\n","        dados = extrair_dados_produto(link, categoria, i)\n","        if dados:\n","            todos.append(dados)\n","\n","        # Salva a cada 100 produtos ou no último\n","        if i % 100 == 0 or i == len(links):\n","            df = pd.DataFrame(todos, columns=[\n","                \"Código\", \"Nome\", \"Preço Promocional\", \"Descrição\",\n","                \"Imagem\", \"URL\", \"Loja\", \"Categoria\"\n","            ])\n","            df.to_csv(os.path.join(pasta_backup, f\"{categoria}_parcial_{i}.csv\"), index=False, sep=\";\")\n","            df.to_excel(os.path.join(pasta_backup, f\"{categoria}_parcial_{i}.xlsx\"), index=False)\n","            print(f\"💾 [{categoria}] Dados salvos com {i} produtos.\")\n","            todos.clear()\n","\n","# ========================\n","# Unificação final\n","# ========================\n","todos_csv = [os.path.join(pasta_backup, arq) for arq in os.listdir(pasta_backup) if arq.endswith(\".csv\")]\n","dfs = [pd.read_csv(arq, sep=\";\") for arq in todos_csv]\n","df_final = pd.concat(dfs, ignore_index=True)\n","\n","csv_final = os.path.join(pasta_base, f\"coleta_FINAL_{data_hoje}.csv\")\n","xlsx_final = os.path.join(pasta_base, f\"coleta_FINAL_{data_hoje}.xlsx\")\n","\n","df_final.to_csv(csv_final, index=False, sep=\";\")\n","df_final.to_excel(xlsx_final, index=False)\n","\n","print(f\"\\n📦 Arquivo final salvo: {csv_final}\")\n","print(f\"📦 Arquivo final salvo: {xlsx_final}\")\n","\n","# ========================\n","# Compactar backup\n","# ========================\n","zip_backup = os.path.join(pasta_base, f\"backup_{data_hoje}.zip\")\n","with zipfile.ZipFile(zip_backup, 'w', zipfile.ZIP_DEFLATED) as zipf:\n","    for raiz, dirs, arquivos in os.walk(pasta_backup):\n","        for arquivo in arquivos:\n","            caminho_arquivo = os.path.join(raiz, arquivo)\n","            zipf.write(caminho_arquivo, os.path.relpath(caminho_arquivo, pasta_base))\n","\n","print(f\"🗜 Backup compactado: {zip_backup}\")\n"]}]}