ip\n"]}],"source":["# Instalações para Google Colab\n","!apt-get update > /dev/null\n","!apt install chromium-chromedriver -y > /dev/null\n","!cp /usr/lib/chromium-browser/chromedriver /usr/bin\n","!pip install selenium pandas openpyxl > /dev/null\n","\n","# Imports\n","import os, re, time, requests, zipfile\n","from datetime import datetime\n","from bs4 import BeautifulSoup\n","import pandas as pd\n","from selenium import webdriver\n","from selenium.webdriver.chrome.options import Options\n","from selenium.webdriver.common.by import By\n","\n","# Função para limpar texto\n","def limpar(texto):\n","    return ' '.join(texto.strip().split()) if texto else \"N/A\"\n","\n","# Data e pastas\n","data_hoje = datetime.now().strftime('%Y-%m-%d')\n","pasta_base = f\"{data_hoje}_casa_rossi\"\n","os.makedirs(pasta_base, exist_ok=True)\n","\n","# WebDriver Headless\n","options = Options()\n","options.binary_location = \"/usr/bin/chromium-browser\"\n","options.add_argument(\"--headless\")\n","options.add_argument(\"--no-sandbox\")\n","options.add_argument(\"--disable-dev-shm-usage\")\n","driver = webdriver.Chrome(options=options)\n","\n","# Coletar links\n","def coletar_links_produtos():\n","    url_base = 'https://www.casarossi.com.br/pisos-e-revestimentos/porcelanatos/acetinado'\n","    headers = {\"User-Agent\": \"Mozilla/5.0\"}\n","    response = requests.get(url_base, headers=headers)\n","    soup = BeautifulSoup(response.text, 'html.parser')\n","    ultima_pagina_tag = soup.select_one(\"li.page.last a\")\n","    total_paginas = int(re.search(r'pg=(\\d+)', ultima_pagina_tag['href']).group(1)) if ultima_pagina_tag else 1\n","\n","    links = []\n","    for pagina in range(1, total_paginas + 1):\n","        url_pagina = f\"{url_base}?pg={pagina}\"\n","        response = requests.get(url_pagina, headers=headers)\n","        soup = BeautifulSoup(response.text, 'html.parser')\n","        produtos = soup.find_all('li', class_='item flex')\n","\n","        for produto in produtos:\n","            a_tag = produto.find('a', class_='space-image')\n","            if a_tag:\n","                link = a_tag['href']\n","                if not link.startswith(\"http\"):\n","                    link = \"https://www.casarossi.com.br\" + link\n","                links.append(link)\n","        time.sleep(1)\n","        if len(links) >= 5:\n","            break\n","    return links[:5]\n","\n","# Coleta dos dados\n","links_produtos = coletar_links_produtos()\n","dados = []\n","\n","for i, url in enumerate(links_produtos):\n","    print(f\"[{i+1}/5] Coletando: {url}\")\n","    try:\n","        driver.get(url)\n","        time.sleep(3)\n","        soup = BeautifulSoup(driver.page_source, 'html.parser')\n","\n","        nome = limpar(soup.find('h1', class_='product-name').text)\n","        codigo = limpar(soup.select_one('.product-sku .ref').text) if soup.select_one('.product-sku .ref') else nome[:20]\n","        preco_original = soup.select_one('.PrecoPrincipal span')\n","        preco_caixa = limpar(preco_original.text) if preco_original else \"N/A\"\n","        preco_m2 = soup.select_one('.preco-por-metro')\n","        preco_m2 = limpar(preco_m2.text.replace('por m²', '').replace('R$', '').strip()) if preco_m2 else \"N/A\"\n","        m2_caixa = soup.select_one('.metro-na-caixa')\n","        m2_caixa = limpar(m2_caixa.text.replace('Caixa com', '').replace('m²', '').strip()) if m2_caixa else \"N/A\"\n","\n","        # Imagem\n","        imagem_tag = soup.select_one('.zoom img')\n","        imagem_url = imagem_tag['src'] if imagem_tag else \"N/A\"\n","\n","        # DESCRIÇÃO: Buscar o conteúdo da div com id=\"descricao\"\n","        descricao_html = soup.find('div', id='descricao')\n","        descricao = limpar(descricao_html.get_text(separator=' ')) if descricao_html else \"N/A\"\n","\n","        # Especificações: Extração dos itens da div com id=\"caracteristicas\"\n","        espec_div = soup.find('div', id='caracteristicas')\n","        if espec_div:\n","            itens = espec_div.find_all('li')\n","            especificacoes = ' | '.join([limpar(li.text) for li in itens])\n","        else:\n","            especificacoes = \"N/A\"\n","\n","        # Comparar preços\n","        preco_promocional = preco_caixa\n","        if preco_m2 != \"N/A\" and preco_caixa != \"N/A\" and preco_caixa == preco_caixa:\n","            preco_promocional = \"N/A\"\n","\n","        dados.append([\n","            codigo,\n","            nome,\n","            preco_promocional,\n","            preco_caixa,\n","            preco_m2,\n","            especificacoes,\n","            descricao,\n","            imagem_url,\n","            url,\n","            \"Casa Rossi\"\n","        ])\n","\n","    except Exception as e:\n","        print(f\"Erro no produto: {e}\")\n","\n","driver.quit()\n","\n","# Criar DataFrame\n","df = pd.DataFrame(dados, columns=[\n","    \"Código\", \"Nome\", \"Preço Promocional\", \"Preço Original\", \"Preço por m²\",\n","    \"Especificações\", \"Descrição\", \"Imagem\", \"URL\", \"Loja\"\n","])\n","\n","# Ajustar valores numéricos\n","def limpar_preco(valor):\n","    try:\n","        return float(valor.replace(\"R$\", \"\").replace(\".\", \"\").replace(\",\", \".\").strip())\n","    except:\n","        return None\n","\n","df[\"Preço por m²\"] = df[\"Preço por m²\"].apply(limpar_preco)\n","df[\"Preço Original\"] = df[\"Preço Original\"].apply(limpar_preco)\n","df[\"Preço Promocional\"] = df.apply(\n","    lambda row: row[\"Preço Promocional\"] if row[\"Preço Promocional\"] != row[\"Preço Original\"] else \"N/A\", axis=1\n",")\n","\n","# Salvar CSV e Excel\n","csv_path = os.path.join(pasta_base, f\"casa_rossi_{data_hoje}.csv\")\n","xlsx_path = os.path.join(pasta_base, f\"casa_rossi_{data_hoje}.xlsx\")\n","\n","df.to_csv(csv_path, sep=';', index=False, encoding='utf-8-sig')\n","df.to_excel(xlsx_path, index=False)\n","\n","# Baixar imagens\n","images_dir = os.path.join(pasta_base, f\"imagens_casa_rossi_{data_hoje}\")\n","os.makedirs(images_dir, exist_ok=True)\n","\n","for index, row in df.iterrows():\n","    codigo = row[\"Código\"]\n","    img_url = row[\"Imagem\"]\n","    if img_url != \"N/A\":\n","        try:\n","            img_resp = requests.get(img_url, stream=True, timeout=10)\n","            if img_resp.status_code == 200:\n","                imagem_path = os.path.join(images_dir, f\"{codigo}.png\")\n","                with open(imagem_path, \"wb\") as img_file:\n","                    for chunk in img_resp.iter_content(1024):\n","                        img_file.write(chunk)\n","            else:\n","                print(f\"❌ Erro ao baixar imagem para o código {codigo}: Status code {img_resp.status_code}\")\n","        except Exception as e:\n","            print(f\"❌ Erro ao baixar imagem para o código {codigo}: {e}\")\n","    else:\n","        print(f\"❌ Nenhuma imagem encontrada para o código {codigo}.\")\n","\n","# Compactar as imagens em um arquivo zip\n","zip_filename = os.path.join(pasta_base, f\"imagens_casa_rossi_{data_hoje}.zip\")\n","with zipfile.ZipFile(zip_filename, \"w\", zipfile.ZIP_DEFLATED) as zipf:\n","    for foldername, subfolders, filenames in os.walk(images_dir):\n","        for filename in filenames:\n","            file_path = os.path.join(foldername, filename)\n","            arcname = os.path.relpath(file_path, images_dir)\n","            zipf.write(file_path, arcname=arcname)\n","\n","# Mensagens finais com ícones\n","print(f\"📄 CSV salvo em: {csv_path}\")\n","print(f\"📊 Excel salvo em: {xlsx_path}\")\n","print(f\"📦 Imagens compactadas em: {zip_filename}\")\n"]}]}